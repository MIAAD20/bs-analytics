# Copy this file to .env and fill in real values. Never commit .env to source control.

# Obtained from https://developer.brawlstars.com. Must be an API key
# allowlisted for the deployment server's public IP address (the Brawl
# Stars API restricts keys to a single IP).
BRAWL_STARS_API_TOKEN=

# Obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user ID of the bot owner (obtained by messaging
# @userinfobot). Enables /addtrigger and /removetrigger for managing bot
# keyword triggers without redeploying. Leave unset to disable those
# two commands.
TELEGRAM_BOT_OWNER_ID=

# Any long random password for the PostgreSQL container.
POSTGRES_PASSWORD=change_me_to_something_long_and_random

# Random 32+ character string, used to sign admin session tokens once an
# admin panel is added. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ENV=production
LOG_LEVEL=INFO
